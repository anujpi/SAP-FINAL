{
  "welcomeFile": "/welcome.html",
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/welcome.html"
  },
  "routes": [
    {
      "source": "^/(passport/check\\(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/(worker|manager|passport|user)(.*)$",
      "target": "$1$2",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/(check|welcome)\\.html$",
      "target": "$1.html",
      "localDir": "resources",
      "authenticationType": "none"
    },
    {
      "source": "^/assets/(.*)$",
      "target": "assets/$1",
      "localDir": "resources",
      "authenticationType": "none"
    },
    {
      "source": "^/index\\.html$",
      "target": "index.html",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    }
  ]
}
