# Copy to .env for local runs. .env is ignored by git, so never commit real keys.

# Backup LLM route, used when Generative AI Hub isn't bound.
ANTHROPIC_API_KEY=

# Free backup LLM route (Google Gemini Flash), used when neither of the above is set.
GEMINI_API_KEY=

# Generative AI Hub: the model name from AI Launchpad. Optional for the direct route.
LLM_MODEL=

# Generative AI Hub locally: the AI Core service key as one line of JSON.
AICORE_SERVICE_KEY=

# Optional: pin one orchestration deployment when the tenant has several (some refuse certain models).
AICORE_DEPLOYMENT_ID=
